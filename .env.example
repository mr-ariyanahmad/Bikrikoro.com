# Supabase — same project as the Android app. The anon key is safe to
# commit/ship in client code (it's designed to be public — RLS policies
# are what actually gate access), so it's filled in here already.
VITE_SUPABASE_URL=https://lrwvbwkkapmwehvxkqlt.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxyd3Zid2trYXBtd2VodnhrcWx0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0NTM0NjUsImV4cCI6MjEwMjAyOTQ2NX0.cO_p4iCsxXrON6NxfVRqjuNiXeM9i3odp8HVu6SHyF0

# ⚠️ NEVER put the service_role key in this file or anywhere under src/.
# Any VITE_-prefixed variable gets bundled into the JS shipped to every
# visitor's browser — a service_role key there means anyone who opens
# devtools can read/write your entire database, bypassing every RLS
# policy. service_role only ever belongs server-side (a Supabase Edge
# Function, or a future admin-only backend) — never in this project.

# Firebase — MUST be the same Firebase project as the Android app
# (BikriKoro/app/google-services.json -> project_info.project_id).
# Get these from Firebase Console -> Project settings -> General ->
# "Your apps" -> add a Web app if one doesn't exist yet (free, no extra billing).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public Web Push certificate key from Firebase Console -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# Server-only Vercel variables; never prefix these with VITE_ and never commit values.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# SUPABASE_SERVICE_ROLE_KEY=

# UddoktaPay is NOT configured here — it's a server-side-only secret used
# by Supabase Edge Functions (uddoktapay-create-charge, uddoktapay-webhook),
# never by this website's client code. Set it with:
#   supabase secrets set UDDOKTAPAY_API_KEY=xxxxx UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com SITE_URL=https://bikrikoro.com
# See supabase/functions/uddoktapay-create-charge/index.ts for details.
